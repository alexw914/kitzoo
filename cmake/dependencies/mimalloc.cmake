# mimalloc builds as a static library for its mi_* API and, with
# KITZOO_MIMALLOC_OVERRIDE, as one object file that overrides malloc and new.
if(KITZOO_MIMALLOC_OVERRIDE)
    set(KITZOO_MIMALLOC_OVERRIDE_OPTIONS MI_OVERRIDE=ON MI_BUILD_OBJECT=ON MI_OSX_ZONE=ON MI_OSX_INTERPOSE=ON)
else()
    set(KITZOO_MIMALLOC_OVERRIDE_OPTIONS MI_OVERRIDE=OFF MI_BUILD_OBJECT=OFF MI_OSX_ZONE=OFF MI_OSX_INTERPOSE=OFF)
endif()
kitzoo_fetch_dependency(
    mimalloc
    GIT_REPOSITORY https://github.com/microsoft/mimalloc.git
    GIT_TAG v3.5.3
    OPTIONS MI_BUILD_SHARED=OFF MI_BUILD_STATIC=ON MI_BUILD_TESTS=OFF MI_INSTALL_TOPLEVEL=ON
            ${KITZOO_MIMALLOC_OVERRIDE_OPTIONS})
